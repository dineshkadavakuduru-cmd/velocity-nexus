# Velocity Nexus - environment template
# Copy to .env.local for local dev: Copy-Item .env.example .env.local
#
# Socket.IO multiplayer server URL.
# - Empty value = single-player only (no socket connection attempted).
# - Local dev: http://localhost:3001 (run `npm run server:dev` in another terminal)
# - Production/preview: your deployed server URL, e.g.
#     https://velocity-nexus-server.up.railway.app
#   Set this as NEXT_PUBLIC_SOCKET_URL in Vercel for BOTH the Production and
#   Preview environments (Dashboard -> Project -> Settings -> Environment
#   Variables, tick both scopes). Preview deployments need it too or every
#   preview build ships with multiplayer disabled.
#
# The scheme is auto-upgraded to match the page, so http:// / ws:// values are
# rewritten to https:// / wss:// on any TLS-served page (avoids mixed content).
# Prefer an https:// URL with NO trailing slash.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
